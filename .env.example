# Leave everything empty to run offline with the deterministic policy model.

# Chat model: LLM_PROVIDER is "openai" or "anthropic"
LLM_PROVIDER=
LLM_MODEL=
OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama or any OpenAI-compatible server
ANTHROPIC_API_KEY=

# Embeddings: unset = offline hashing embedder. Re-run `ingest` after changing this.
EMBEDDING_MODEL=
EMBEDDING_DIM=1536
